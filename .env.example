# ── Base de datos ───────────────────────────────────────────────────
# Railway provee DATABASE_URL automáticamente.
# Para desarrollo local usa las variables individuales.
DATABASE_URL=

DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reservas_gym

# ── Autenticación ───────────────────────────────────────────────────
# Genera un secreto seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_seguro

# ── Servidor ────────────────────────────────────────────────────────
PORT=3000
